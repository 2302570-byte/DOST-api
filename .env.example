# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dostbesmart_db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-long-random-secret-here"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ─── Blockchain (Hedera testnet) ──────────────────────────────────────────────
# Hashio is the free public Hiero JSON-RPC Relay for Hedera testnet.
# Get a testnet account + ECDSA private key at https://portal.hedera.com
# Fund it with free test HBAR from https://portal.hedera.com/faucet

RPC_URL="https://testnet.hashio.io/api"

# ECDSA private key of the backend wallet (the "minter" that signs on-chain txs).
# NEVER commit this. Use a secrets manager in production.
BACKEND_PRIVATE_KEY="0x_your_hedera_ecdsa_private_key_here"

# Set this after running: npm run deploy:hedera (from the points-system folder)
POINTS_CONTRACT_ADDRESS=""
