# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/besmart_db"

# ─── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET="your-long-random-secret-here"
JWT_EXPIRES_IN="7d"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV="development"

# ─── QR Signing ───────────────────────────────────────────────────────────────
QR_SECRET_KEY="your-qr-secret-key-here"
